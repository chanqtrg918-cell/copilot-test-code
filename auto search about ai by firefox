from selenium import webdriver
from selenium.webdriver.common.by import By
from selenium.webdriver.common.keys import Keys
import time

# Initialize Firefox driver (make sure geckodriver is installed and in your PATH)
driver = webdriver.Firefox()

try:
    # Go to Google
    driver.get("https://www.google.com/")

    # Accept cookies if prompted (optional: handle regional consent dialogs)
    try:
        consent_button = driver.find_element(By.XPATH, "//button[contains(., 'Accept all')]")
        consent_button.click()
        time.sleep(1)
    except Exception:
        pass  # No consent dialog

    # Find the search box
    search_box = driver.find_element(By.NAME, "q")
    # Enter search query
    search_box.send_keys("AI articles and topics")
    search_box.send_keys(Keys.RETURN)

    # Wait for results to load
    time.sleep(5)

    # Optionally, print the titles and URLs of the first few results
    results = driver.find_elements(By.CSS_SELECTOR, "h3")
    for i, result in enumerate(results[:5]):
        print(f"{i+1}. {result.text}")

    # Keep the browser open for a while to view results
    time.sleep(10)

finally:
    driver.quit()
